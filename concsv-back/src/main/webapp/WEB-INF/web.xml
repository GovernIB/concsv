<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
		version="4.0">
	<display-name>concsvback</display-name>
	<login-config>
		<auth-method>KEYCLOAK</auth-method>
		<realm-name>Govern de les Illes Balears</realm-name>
	</login-config>
	<security-role>
		<role-name>CSV_SUPER</role-name>
	</security-role>
	<security-constraint>
		<!-- Fitxers estàtics que l'index.html de l'SPA demana directament (no contenen dades). Han
		     de ser públics: mentre la pàgina va i torna de Keycloak per iniciar la sessió, el
		     navegador els demana, i si fossin protegits cada un rebria una redirecció al login amb
		     una galeta OAuth_Token_Request_State nova (path "/", compartida) que trepitjaria la de
		     la pàgina; en tornar, l'adaptador respondria "state parameter invalid" (400). L'arrel
		     /reactapp/ i l'index.html continuen protegits. Spring Security els declara públics
		     igual a WebSecurityConfig.publicRequestMatchers(). -->
		<web-resource-collection>
			<web-resource-name>Public Resources</web-resource-name>
			<url-pattern>/sysenv</url-pattern>
			<url-pattern>/manifest</url-pattern>
			<url-pattern>/reactapp/assets/*</url-pattern>
			<url-pattern>/reactapp/favicon.png</url-pattern>
			<url-pattern>/reactapp/favicon.svg</url-pattern>
		</web-resource-collection>
		<!-- L'API no la protegeix el contenidor (una petició AJAX sense sessió rebria una redirecció
		     al login de Keycloak en lloc d'un 401/403): ho fa Spring Security, que exigeix usuari
		     autenticat a tot /api/* excepte l'índex. Declarar-la per a tots els mètodes (i no només
		     OPTIONS) evita l'avís UT015020 d'Undertow sense canviar el comportament. -->
		<web-resource-collection>
			<web-resource-name>API</web-resource-name>
			<url-pattern>/api/*</url-pattern>
		</web-resource-collection>
	</security-constraint>
	<security-constraint>
		<display-name>Any logged in user</display-name>
		<web-resource-collection>
			<web-resource-name>API resources</web-resource-name>
			<url-pattern>/*</url-pattern>
		</web-resource-collection>
		<auth-constraint>
			<role-name>*</role-name>
		</auth-constraint>
	</security-constraint>
	<security-role>
		<role-name>*</role-name>
	</security-role>
	<!-- Cap JavaScript de l'aplicació no llegeix el JSESSIONID: amb HttpOnly un XSS no la pot robar.
	     SameSite=Lax queda pendent fins que s'actualitzi el servidor d'aplicacions (JBoss EAP 7.2 no
	     ho permet des del web.xml). -->
	<session-config>
		<cookie-config>
			<http-only>true</http-only>
		</cookie-config>
	</session-config>
</web-app>
